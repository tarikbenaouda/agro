{
  "expo": {
    "name": "agro",
    "slug": "agro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "hidden": false,
      "translucent": true,
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tarikbenaouda.agro",
      "config": {
        "googleMaps": {
          "apiKey": "VOTRE_CLE_API_GOOGLE_MAPS_ICI"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez AGRO à utiliser la caméra pour analyser les feuilles et détecter les maladies."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez AGRO à accéder à votre position pour afficher la météo locale."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D5A27",
          "dark": {
            "backgroundColor": "#2D5A27"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "127080ab-bbe5-4bd6-a74f-92d1ca43cb55"
      }
    }
  }
}
